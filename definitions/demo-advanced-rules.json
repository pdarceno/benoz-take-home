{
  "client": "demo",
  "record_type": "event_booking",
  "fields": [
    {
      "name": "event_type",
      "label": "Event type",
      "type": "choice",
      "required": true,
      "options": ["single_day", "multi_day"]
    },
    {
      "name": "start_date",
      "label": "Start date",
      "type": "date",
      "required": true
    },
    {
      "name": "end_date",
      "label": "End date",
      "type": "date",
      "required": false,
      "required_when": {
        "field": "event_type",
        "equals": "multi_day"
      }
    }
  ],
  "rules": [
    {
      "type": "gte",
      "left": "end_date",
      "right": "start_date",
      "message": "End date must not be before start date"
    }
  ]
}
